<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.agenticdb</groupId>
    <artifactId>aidb-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>adb-desktop</artifactId>
  <name>AIDB :: Desktop</name>
  <description>应用入口、jlink 裁剪、jpackage 出包。</description>

  <dependencies>
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-session</artifactId></dependency>
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-introspect</artifactId></dependency>
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-ui-shell</artifactId></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.agenticdb.desktop.Launcher</mainClass>
          <options>
            <option>--enable-native-access=javafx.graphics</option>
            <option>--enable-native-access=ALL-UNNAMED</option>
          </options>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>

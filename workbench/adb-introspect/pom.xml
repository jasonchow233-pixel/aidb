<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.agenticdb</groupId>
    <artifactId>aidb-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>adb-introspect</artifactId>
  <name>AIDB :: Introspect</name>
  <description>元数据内省：表、列、索引、外键、约束、DDL。</description>

  <dependencies>
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-model</artifactId></dependency>
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-jdbc</artifactId></dependency>
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-fixtures</artifactId><scope>test</scope></dependency>
    <!-- Backup 编排需要运行期复用导出引擎（流式 INSERT 生成） -->
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-transfer</artifactId></dependency>
    <!-- 真库契约共用：ExternalDatabase（环境变量读取）与 RealDatabaseContract（断言本体） -->
    <dependency><groupId>io.agenticdb</groupId><artifactId>adb-jdbc</artifactId><type>test-jar</type><scope>test</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    <!-- P5-4：PostgreSQL 内省契约（无 Docker 时整类跳过） -->
    <dependency><groupId>org.testcontainers</groupId><artifactId>postgresql</artifactId><scope>test</scope></dependency>
    <dependency><groupId>org.testcontainers</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
  </dependencies>
</project>

# ============================================================================
# apps/desktop/package.json —— 相关片段
# ============================================================================

{
  "scripts": {
    "dev": "vite",
    "build": "vite build",

    // ⭐⭐ 五道保险（三、四）
    "generate:types": "tsx scripts/generate-types.ts",
    "pretypecheck": "pnpm generate:types",
    "pretest": "pnpm generate:types",
    "check:types": "tsx scripts/generate-types.ts --check",

    "typecheck": "vue-tsc --noEmit --project tsconfig.json",
    "lint": "oxlint --vue-plugin src --max-warnings=0",
    "fmt": "oxfmt \"src/**/*.{ts,vue}\"",

    // ⭐ CI 汇总入口（保险五）
    "check": "pnpm check:types && pnpm typecheck && pnpm lint && pnpm test",

    "test": "vitest run",
    "test:watch": "vitest",

    // 体积门禁
    "check:bundle": "tsx scripts/check-bundle.ts",
    "bench": "vitest bench"
  },

  // ==========================================================================
  // 依赖预算：≤ 30（M1 只需 20）
  // 对照 DBX 的 21.8MB TypeScript，我们砍掉 cytoscape/leaflet/proj4/
  // vue-virtual-scroller/dom-to-image-more/pako/dayjs/diff 等
  // ==========================================================================
  "dependencies": {
    "vue": "^3.5",
    "pinia": "^3.0",
    "vue-i18n": "^11",

    "@tauri-apps/api": "^2.11",
    "@tauri-apps/plugin-dialog": "^2.7",

    "ag-grid-community": "^34",

    "codemirror": "^6",
    "@codemirror/state": "^6.6",
    "@codemirror/view": "^6.43",
    "@codemirror/language": "^6.12",
    "@codemirror/lang-sql": "^6.10",
    "@codemirror/autocomplete": "^6.20",
    "@codemirror/commands": "^6.10",
    "@codemirror/search": "^6.7",

    "splitpanes": "^4.1",
    "@vueuse/core": "^14",
    "reka-ui": "^2.10",
    "lucide-vue-next": "^0.4",

    "tailwindcss": "^4.3",
    "@tailwindcss/vite": "^4.3",
    "class-variance-authority": "^0.7",
    "clsx": "^2.1",
    "tailwind-merge": "^3.6",

    "@internationalized/date": "^3.12",

    "yaml": "^2.7"
  },

  "devDependencies": {
    "vite": "^7",
    "typescript": "^5.7",
    "vue-tsc": "^2.2",
    "@vitejs/plugin-vue": "^6",
    "vitest": "^3",
    "@vue/test-utils": "^2",
    "playwright": "^1.49",
    "oxlint": "^1",
    "oxfmt": "^1",
    "tsx": "^4",
    "yaml": "^2.7",
    "tailwindcss": "^4.3",
    "@tailwindcss/vite": "^4.3",
    "@types/node": "^22"
  }
}

<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  AgenticDB —— 父 POM

  ⭐ 唯一技术路线：Java 25 + JavaFX 25 原生桌面（不再有 Rust / Vue / WebView）
  ⭐ 公开路线图：docs/ROADMAP.md
  ⭐ 架构：docs/ARCHITECTURE.md
  ⭐ 组件选型：docs/COMPONENT-SELECTION.md

  规则：
  1. 所有三方依赖版本只允许写在这里，子模块不得带 <version>。
  2. 业务代码不得出现颜色字面量（只在生成的 Tokens.java / theme-*.css 里）。
  3. 新增依赖必须先更新本文件与 docs/COMPONENT-SELECTION.md。
  ============================================================================
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.agenticdb</groupId>
  <artifactId>aidb-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>AIDB</name>
  <description>跨平台多数据库管理桌面客户端</description>
  <url>https://github.com/jasonchow233-pixel/aidb</url>
  <inceptionYear>2026</inceptionYear>

  <!-- 许可与源码位置写进 POM 是发布工程的第一步：Maven 中央仓库的元数据、
       `mvn license:third-party-report`、以及 IDE 的依赖视图都读这里。
       与根目录 LICENSE / NOTICE 三个文件必须一致：本仓库 Apache-2.0，
       三方许可（含 MySQL Connector/J 的 GPLv2 + Universal FOSS Exception）见 NOTICE。 -->
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <scm>
    <url>https://github.com/jasonchow233-pixel/aidb</url>
    <connection>scm:git:https://github.com/jasonchow233-pixel/aidb.git</connection>
    <developerConnection>scm:git:git@github.com:jasonchow233-pixel/aidb.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/jasonchow233-pixel/aidb/issues</url>
  </issueManagement>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>

    <javafx.version>25</javafx.version>
    <controlsfx.version>11.2.6</controlsfx.version>
    <richtextfx.version>0.11.7</richtextfx.version>
    <!-- D-97：编辑器外层视口（滚动条）用的类在 flowless 里，richtextfx 是**传递**带进来的。
         代码里直接 import 它就得自己声明 —— 版本号必须与 richtextfx 那一份对齐，
         写成 property 是为了让「richtextfx 升级时这里必须复核」这件事留在明面上。 -->
    <flowless.version>0.7.4</flowless.version>

    <jackson.version>2.22.4</jackson.version>
    <!-- Jackson 2.22 起 annotations 独立发版，版本号不带 patch。 -->
    <jackson-annotations.version>2.22</jackson-annotations.version>

    <junit.version>5.10.2</junit.version>
    <assertj.version>3.27.6</assertj.version>
    <testfx.version>4.0.18</testfx.version>
    <monocle.version>21.0.2</monocle.version>
    <testcontainers.version>1.21.4</testcontainers.version>

    <sqlite.version>3.45.1.0</sqlite.version>
    <postgresql.version>42.7.14</postgresql.version>
    <mysql.version>8.2.0</mysql.version>
    <!-- D 系列（C-3 拍板）：MariaDB / SQL Server / Oracle 驱动。
         许可证：mariadb-java-client = LGPL-2.1（评估见 COMPONENT-SELECTION.md）、
         mssql-jdbc = MIT、ojdbc11 = Unicode-3.0。 -->
    <mariadb.version>3.3.3</mariadb.version>
    <mssql.version>12.8.1.jre11</mssql.version>
    <ojdbc11.version>23.5.0.24.07</ojdbc11.version>
    <!-- G5a：SSH 隧道。Apache MINA SSHD 同时带客户端与服务端（服务端只用在测试里，
         这样「隧道真的转发过一条 TCP」能在没有第二台机器的情况下量到）。
         许可证 Apache-2.0，评估见 docs/COMPONENT-SELECTION.md。 -->
    <sshd.version>2.20.1</sshd.version>
    <!-- MINA SSHD 记日志走 SLF4J；本项目自己不用它，装一个 JUL 转发，
         免得控制台出现「no providers will be used」而把隧道故障吞成沉默。 -->
    <slf4j.version>2.0.17</slf4j.version>
    <jna.version>5.13.0</jna.version>
    <poi.version>5.4.1</poi.version>

    <!-- EXT：Redis / 对象存储 SDK 选型（P0-4 落地，P1/P2 使用） -->
    <!-- Lettuce：netty 异步模型贴合现有执行器，优于 Jedis（EXT 规划 Q3）。 -->
    <lettuce.version>6.6.0.RELEASE</lettuce.version>
    <!-- AWS SDK v2（S3 兼容，含 minio / localstack 测试）。 -->
    <aws.sdk.version>2.31.0</aws.sdk.version>
    <!-- 阿里云 OSS（注意其 license 与 NOTICE 同步）。 -->
    <aliyun.oss.version>3.18.5</aliyun.oss.version>
    <!-- 七牛云 Kodo（无服务端 move，UI 须置灰说明）。 -->
    <qiniu.version>7.19.0</qiniu.version>
    <!-- 腾讯云 COS。 -->
    <cos.version>5.6.227</cos.version>

    <maven-compiler-plugin.version>3.15.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    <maven-jar-plugin.version>3.4.1</maven-jar-plugin.version>
    <maven-enforcer-plugin.version>3.7.0</maven-enforcer-plugin.version>
    <javafx-maven-plugin.version>0.0.8</javafx-maven-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- ── 内部模块 ─────────────────────────────────────────────── -->
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-model</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-safety</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-sql</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-jdbc</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- adb-jdbc 的测试产物：真库契约（ExternalDatabase / RealDatabaseContract）
           跨模块共享，避免两个模块各写一份环境变量名。 -->
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-jdbc</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-introspect</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-session</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-editing</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-transfer</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-fixtures</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-ui-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-ui-shell</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- EXT：资产族抽象地基 -->
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-asset</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- EXT：Redis 管理 -->
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-redis</artifactId>
        <version>${project.version}</version>
      </dependency>
      <!-- EXT：对象存储管理 -->
      <dependency>
        <groupId>io.agenticdb</groupId>
        <artifactId>adb-objectstore</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!-- ── UI ──────────────────────────────────────────────────── -->
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-controls</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-graphics</artifactId>
        <version>${javafx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.controlsfx</groupId>
        <artifactId>controlsfx</artifactId>
        <version>${controlsfx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fxmisc.richtext</groupId>
        <artifactId>richtextfx</artifactId>
        <version>${richtextfx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.fxmisc.flowless</groupId>
        <artifactId>flowless</artifactId>
        <version>${flowless.version}</version>
      </dependency>

      <!-- ── 数据 / 契约 ─────────────────────────────────────────── -->
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-annotations</artifactId>
        <version>${jackson-annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <!-- JNA：Windows WinCred（advapi32!Cred*）系统凭据库 -->
      <dependency>
        <groupId>net.java.dev.jna</groupId>
        <artifactId>jna</artifactId>
        <version>${jna.version}</version>
      </dependency>

      <!-- ── JDBC ────────────────────────────────────────────────── -->
      <dependency>
        <groupId>org.xerial</groupId>
        <artifactId>sqlite-jdbc</artifactId>
        <version>${sqlite.version}</version>
      </dependency>
      <dependency>
        <groupId>org.postgresql</groupId>
        <artifactId>postgresql</artifactId>
        <version>${postgresql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.mysql</groupId>
        <artifactId>mysql-connector-j</artifactId>
        <version>${mysql.version}</version>
      </dependency>
      <!-- ⭐ D-0：三方驱动坐标（只锁版本；是否进运行时由各自模块声明）。 -->
      <dependency>
        <groupId>org.mariadb.jdbc</groupId>
        <artifactId>mariadb-java-client</artifactId>
        <version>${mariadb.version}</version>
      </dependency>
      <dependency>
        <groupId>com.microsoft.sqlserver</groupId>
        <artifactId>mssql-jdbc</artifactId>
        <version>${mssql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.oracle.database.jdbc</groupId>
        <artifactId>ojdbc11</artifactId>
        <version>${ojdbc11.version}</version>
      </dependency>

      <!-- Apache POI：xlsx 导入导出（导出 SXSSF / 导入 SAX，均流式） -->
      <dependency>
        <groupId>org.apache.poi</groupId>
        <artifactId>poi-ooxml</artifactId>
        <version>${poi.version}</version>
      </dependency>

      <!-- ── 测试 ────────────────────────────────────────────────── -->
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testfx</groupId>
        <artifactId>testfx-junit5</artifactId>
        <version>${testfx.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testfx</groupId>
        <artifactId>openjfx-monocle</artifactId>
        <version>${monocle.version}</version>
      </dependency>
      <!-- Testcontainers：PostgreSQL / MySQL 的真库联调（MIT） -->
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>postgresql</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>mysql</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${testcontainers.version}</version>
      </dependency>
      <!-- ── G5a：SSH 隧道（Apache MINA SSHD，Apache-2.0）──────────────
           sshd-core 里客户端与服务端同包：契约用它在本机起一把真 sshd，
           于是「隧道转发」这件事不需要第二台机器也能量。 -->
      <dependency>
        <groupId>org.apache.sshd</groupId>
        <artifactId>sshd-core</artifactId>
        <version>${sshd.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-jdk14</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
          <configuration>
            <!-- ⭐ D-85 第四族（fork 无声退出，码 0 无 dump）：崩的时候要留得下证据。
                 hs_err / 堆转储统一落各模块 target/，别散在基于目录里被 clean 冲掉；
                 fork 拖到不肯说再见时多等两分钟再判死，减少误报「terminated without saying goodbye」。 -->
            <argLine>--enable-native-access=ALL-UNNAMED
              -XX:ErrorFile=target/hs_err_pid%p.log
              -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=target</argLine>
            <forkedProcessExitTimeoutInSeconds>120</forkedProcessExitTimeoutInSeconds>
            <!-- TestFX / Monocle 无头参数；只在 UI 测试里生效 -->
            <systemPropertyVariables>
              <testfx.robot>glass</testfx.robot>
              <testfx.headless>true</testfx.headless>
              <prism.order>sw</prism.order>
              <glass.platform>Monocle</glass.platform>
              <monocle.platform>Headless</monocle.platform>
              <!-- 启动打点只在真实运行时落盘；测试 JVM 会反复启动 App，不污染 ~/.agenticdb/logs。 -->
              <adb.startup.log>false</adb.startup.log>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.openjfx</groupId>
          <artifactId>javafx-maven-plugin</artifactId>
          <version>${javafx-maven-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-java-version</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <requireJavaVersion><version>[25,28)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
                <banDuplicatePomDependencyVersions/>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <modules>
    <!-- core：纯 Java，零 UI 依赖 -->
    <module>core/adb-model</module>
    <module>core/adb-safety</module>
    <module>core/adb-sql</module>

    <!-- workbench：业务编排，可单测 -->
    <module>workbench/adb-jdbc</module>
    <module>workbench/adb-introspect</module>
    <module>workbench/adb-session</module>
    <module>workbench/adb-editing</module>
    <module>workbench/adb-transfer</module>
    <!-- EXT：资产族抽象地基（AssetKind / AssetFamily 注册表） -->
    <module>workbench/adb-asset</module>
    <!-- EXT：Redis 管理（P1） -->
    <module>workbench/adb-redis</module>
    <!-- EXT：对象存储管理 S3 / 阿里云 OSS / 七牛 / 腾讯云 COS（P2） -->
    <module>workbench/adb-objectstore</module>

    <!-- ui：JavaFX -->
    <module>ui/adb-ui-core</module>
    <module>ui/adb-ui-shell</module>

    <!-- testing -->
    <module>testing/adb-fixtures</module>

    <!-- bootstrap：组装与打包 -->
    <module>bootstrap/adb-desktop</module>
  </modules>
</project>
